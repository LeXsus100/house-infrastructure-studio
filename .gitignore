*.house-project.json

# Local environment/package credentials and machine overrides
.env
.env.*
!.env.example
.npmrc
*.local
*.tgz

# Personal branding and the legacy Windows launcher stay on this machine
AGENTS.md
public/house_icon.png
house_icon.png
start-house-studio.bat

# Tauri/Rust generated binaries and signing material
src-tauri/target/
target/
src-tauri/binaries/*
