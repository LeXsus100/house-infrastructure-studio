!src-tauri/resources/server/.gitkeep
src-tauri/resources/licenses/*
!src-tauri/resources/licenses/.gitkeep
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.msi
*-setup.exe
*.sig

